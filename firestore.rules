rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções de acesso ─────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActiveUser() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }
    function isAdmin() { return isActiveUser() && get(profilePath()).data.role == 'admin'; }
    // Conta do administrador principal (usada só no primeiro acesso, para criar o próprio perfil)
    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'admin@xcmg-apoio.app';
    }

    // ── Usuários ──────────────────────────────────────────────────────────
    // Índice usuário → e-mail interno, consultado na tela de login (antes de entrar)
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || (username == 'admin' && isBootstrapAdmin() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Perfis: nome, perfil (admin/user), ativo, troca de senha pendente
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.auth.uid == uid && isBootstrapAdmin() && request.resource.data.role == 'admin');
      // O próprio usuário só pode marcar a troca de senha e o último acesso
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['mustChangePassword', 'passwordChangedAt', 'lastLoginAt'])
            && request.resource.data.mustChangePassword in [false, resource.data.mustChangePassword]);
      allow delete: if isAdmin();
    }

    // ── Dados do app (somente usuários ativos) ────────────────────────────
    match /current_state/{docId} {
      allow read, write: if isActiveUser();
    }
    match /relatorio_history/{docId} {
      allow read, write: if isActiveUser();
    }
    match /equipment_snapshots/{docId} {
      allow read, write: if isActiveUser();
    }
    match /equipment_events/{docId} {
      allow read, create: if isActiveUser();
    }
  }
}
